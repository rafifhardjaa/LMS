{
  "name": "lms_sem5",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:storage": "drizzle-kit generate --config=drizzle.storage.config.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:setup": "bun run db:migrate && bun run seed",
    "db:backfill-passwords": "bun run scripts/fill-default-passwords.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:import-jadwal": "bun run scripts/import-jadwal-xlsx.ts",
    "db:import-guru": "bun run scripts/import-users-guru-xlsx.ts",
    "db:import-siswa": "bun run scripts/import-siswa-xlsx.ts",
    "db:push": "drizzle-kit push",
    "db:sync-curriculum": "bun run scripts/sync-curriculum.ts",
    "seed": "bun run src/db/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "exceljs": "^4.4.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.9"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.15.18": true
  }
}
