DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simanis"
STORAGE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storage_simanis"
JWT_SECRET=supersecretjwtkey_change_me_in_production
PORT=3000

# URL frontend — dipakai untuk tautan aktivasi & reset password di email.
APP_URL=http://localhost:3001

# Origin tambahan yang diizinkan CORS (opsional), dipisah koma.
# Origin dari APP_URL selalu diizinkan.
# Contoh: CORS_ORIGINS=https://staging.simanis.sch.id,https://preview.simanis.sch.id
CORS_ORIGINS=

# Set true hanya jika backend berada di balik reverse proxy tepercaya
# (X-Forwarded-For dipakai untuk rate limit per IP).
TRUST_PROXY=false

# Email transaksional (opsional di development).
# Tanpa SMTP (atau MAIL_DEV=true), tautan aktivasi/reset dicetak ke console.
MAIL_DEV=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SiManis LMS <no-reply@simanis.local>"
